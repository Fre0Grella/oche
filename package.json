{
  "name": "oche",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Darts scoring, calling and statistics in the browser, with a camera autoscorer.",
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "npm run dev --workspace @oche/web",
    "build": "npm run build --workspace @oche/web",
    "preview": "npm run preview --workspace @oche/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build --force"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
